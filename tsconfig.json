{
  "compilerOptions": {
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": false,
    "esModuleInterop": true,
    "module": "esnext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "types": ["vite/client"],
  },
  "include": ["src/env.d.ts", "src/main.ts", "src/router.ts", "src/store.ts", "src/**/*.vue", "src/commands.ts", "src/bindings/**/*.ts", "vite.config.ts", "uno.config.ts"],
  "exclude": [
    "node_modules", "src/**/*.tsx", "src/equalSelector.ts", "src/utils.ts", "src/transitions.ts"
  ]
}
